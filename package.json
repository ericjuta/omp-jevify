{
	"name": "@ericjuta/omp-jevify",
	"version": "0.5.0",
	"description": "Oh My Pi source-backed evidence preparation, review workflows, Clairic extraction and optional Jev classification",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ericjuta/omp-jevify.git"
	},
	"homepage": "https://github.com/ericjuta/omp-jevify#readme",
	"bugs": {
		"url": "https://github.com/ericjuta/omp-jevify/issues"
	},
	"keywords": ["omp", "oh-my-pi", "omp-plugin", "skill", "jev", "judge_batch", "clairic", "evidence"],
	"files": ["skills/jevify/*.md", "skills/jevify/*.py", "src", "README.md", "LICENSE"],
	"engines": { "bun": ">=1.3.14" },
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test:adapter": "bun test tests/adapter",
		"smoke:adapter": "bun run tests/adapter/installed-smoke.ts"
	},
	"omp": { "extensions": ["./src/index.ts"] },
	"peerDependencies": { "@oh-my-pi/pi-coding-agent": ">=18.10.3 <19" },
	"peerDependenciesMeta": { "@oh-my-pi/pi-coding-agent": { "optional": true } },
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "18.10.3",
		"@types/bun": "1.3.14",
		"typescript": "5.9.3"
	}
}
